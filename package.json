{
  "name": "painel-lcdpr",
  "private": true,
  "version": "0.1.0",
  "description": "Painel web estático para análise do arquivo TXT do LCDPR (Grupo Paraná). O arquivo é lido só no navegador.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sigilo": "node scripts/verificar-sigilo.mjs",
    "verificar": "npm run sigilo && npm run typecheck && npm test && npm run build",
    "fixtures": "node scripts/gerar-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "echarts": "^6.1.0"
  }
}
