{
  "name": "painel-lcdpr",
  "private": true,
  "version": "0.1.0",
  "description": "Painel web estático para análise do arquivo TXT do LCDPR (Grupo Paraná). O arquivo é lido só no navegador.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
